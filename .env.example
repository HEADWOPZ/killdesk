# Official TypeSafe API. Console: https://console.typesafe.ai
# Endpoint: https://api.typesafe.ai/v1/systemone
# thejevai.com is NOT the official TypeSafe site.
TYPESAFE_API_KEY=

# Alternative transport. Jev is listed on OpenRouter as typesafe/jev.
# KillDesk posts to https://openrouter.ai/api/v1/systemone
OPENROUTER_API_KEY=

# typesafe | openrouter | mock
# With no key, pass `killdesk run --mock` instead of setting this.
KILLDESK_JUDGE_BACKEND=
KILLDESK_JUDGE_MODEL=jev-latest

# Optional. BSC chain_kill degrades gracefully when this is empty.
# Etherscan V2: https://api.etherscan.io/v2/api?chainid=56
ETHERSCAN_API_KEY=

# Optional. Notifications are skipped when either value is empty.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Public RPCs. No wallet key belongs here.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
BSC_RPC_URL=https://bsc-dataseed.binance.org

KILLDESK_DB=desk.db
